{
  "id": "../",
  "name": "Scriptorium",
  "short_name": "Scriptorium",
  "description": "Your self-hosted library, automated.",
  "start_url": "../",
  "scope": "../",
  "display": "standalone",
  "background_color": "#0E1016",
  "theme_color": "#0E1016",
  "categories": ["books", "education", "entertainment"],
  "icons": [
    { "src": "img/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icon.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "img/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ],
  "shortcuts": [
    { "name": "Continue reading", "url": "../", "icons": [{ "src": "img/icon-192.png", "sizes": "192x192" }] },
    { "name": "Highlights", "url": "../highlights", "icons": [{ "src": "img/icon-192.png", "sizes": "192x192" }] },
    { "name": "Search", "url": "../search", "icons": [{ "src": "img/icon-192.png", "sizes": "192x192" }] }
  ],
  "share_target": {
    "action": "../share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [{
        "name": "file",
        "accept": [".epub", ".kepub", ".pdf", ".mobi", ".azw", ".azw3", ".fb2", ".cbz", ".cbr", ".txt", ".docx", ".rtf",
                   "application/epub+zip", "application/pdf", "application/x-mobipocket-ebook", "application/vnd.comicbook+zip"]
      }]
    }
  }
}
