#~ msgstr ""
#~ "Par conséquent, lorsque vous configuré votre fichier docker-compose pour "
#~ "CWA, <b>NE CHANGEZ PAR LES CHEMINS A DROITE DES DEUX-POINTS DANS LES "
#~ "SECTIONS VOLUMES !</b>"

#~ msgid ""
